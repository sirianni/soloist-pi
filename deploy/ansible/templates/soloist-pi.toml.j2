# Managed by Ansible. Non-secret configuration only.
device_name = {{ soloist_pi_device_name | to_json }}
api_key_file = "/var/lib/soloist-pi/config/api-key"
data_dir = {{ soloist_pi_data_dir | to_json }}
cache_dir = "/var/cache/soloist-pi"
{% if soloist_pi_cache_size_mb is not none %}cache_size_mb = {{ soloist_pi_cache_size_mb }}
{% endif %}{% if soloist_pi_pipewire_device is not none %}pipewire_device = {{ soloist_pi_pipewire_device | to_json }}
{% endif %}{% if soloist_pi_initial_volume is not none %}initial_volume = {{ soloist_pi_initial_volume }}
{% endif %}{% if soloist_pi_websocket_address is not none %}websocket_address = {{ soloist_pi_websocket_address | to_json }}
{% endif %}