# Copy this file to /var/lib/soloist-pi/config/config.toml and edit it.
# Keep the file mode 0600; it contains paths and non-secret settings only.
device_name = "Living Room"
api_key_file = "/var/lib/soloist-pi/config/api-key"
data_dir = "/var/lib/soloist-pi/state/soloist"
cache_dir = "/var/cache/soloist-pi"

# Optional settings:
# cache_size_mb = 500 # Use 0 for no limit, or at least 100.
# pipewire_device = "alsa_output.platform-sound.analog-stereo"
# initial_volume = 50 # 0 through 100.
# websocket_address = "127.0.0.1:9000" # Loopback only.
