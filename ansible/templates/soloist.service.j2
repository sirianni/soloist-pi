[Unit]
Description=Spotify Soloist supervisor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=soloist
Group=soloist
WorkingDirectory=/var/lib/soloist
ExecStart=/opt/soloist/venv/bin/soloist-pi run --config /var/lib/soloist/config/config.toml --placeholder
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5s

# Let the supervisor forward SIGTERM to its child before systemd kills the cgroup.
KillMode=mixed
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
